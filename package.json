{
  "name": "greenmantle",
  "private": true,
  "version": "1.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.verify/tests.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "verify": "npm run check:docs && npm run sync:site && npm run check:site && npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:lan": "vite --host 0.0.0.0",
    "preview:lan": "vite preview --host 0.0.0.0",
    "sync:site": "node scripts/sync-site-progress.mjs",
    "predev": "npm run sync:site && npm run build:info",
    "prebuild": "npm run sync:site && npm run build:info",
    "build:info": "node scripts/generate-build-info.mjs",
    "release:tag": "node scripts/tag-release.mjs",
    "archive:check": "git archive --format=tar --prefix=Greenmantle-$npm_package_version/ HEAD | tar tf - | head",
    "capture": "node scripts/capture.mjs",
    "check:site": "node scripts/check-site-sync.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.0",
    "eslint": "^9.39.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.13",
    "vitest": "^3.2.4"
  }
}
